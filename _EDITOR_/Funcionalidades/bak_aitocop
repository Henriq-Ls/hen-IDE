# Gerenciador
# ══════════════════════════════════════════════════════════════════════════════

class GerenciadorAutocomplete:
    def __init__(self, editor):
        self._editor       = editor
        self._lista        = ListaAutocomplete(editor)
        self._project_path : str | None = None
        self._ambiente     = None
        self._proj_jedi    : str | None = None

        self._ambiente, self._proj_jedi = _criar_ambiente(None)
        self._lista.sugestao_confirmada.connect(self._inserir_sugestao)

        self._timer = QTimer()
        self._timer.setSingleShot(True)
        self._timer.setInterval(300)
        self._timer.timeout.connect(self._calcular)

    def set_project_path(self, path: str | None):
        if path == self._project_path:
            return
        self._project_path = path
        self._ambiente, self._proj_jedi = _criar_ambiente(path)

    # ── API ───────────────────────────────────────────────────────────────────

    def interceptar_tecla(self, event) -> bool:
        if not self._lista.isVisible():
            return False
        tecla = event.key()
        if tecla in (Qt.Key_Return, Qt.Key_Enter, Qt.Key_Tab):
            self._lista.confirmar(); return True
        if tecla == Qt.Key_Escape:
            self.fechar(); return True
        if tecla == Qt.Key_Up:
            self._lista.navegar(-1); return True
        if tecla == Qt.Key_Down:
            self._lista.navegar(1); return True
        return False

    def ao_tecla_pressionada(self):
        self._timer.start()

    def fechar(self):
        self._lista.fechar()
        self._timer.stop()

    def esta_visivel(self) -> bool:
        return self._lista.isVisible()

    def navegar_cima(self):   self._lista.navegar(-1)
    def navegar_baixo(self):  self._lista.navegar(1)
    def confirmar(self):      self._lista.confirmar()

    # ── Cálculo ───────────────────────────────────────────────────────────────

    def _calcular(self):
        if not JEDI_DISPONIVEL:
            return

        cursor      = self._editor.textCursor()
        codigo      = self._editor.toPlainText()
        linha       = cursor.blockNumber() + 1
        coluna      = cursor.positionInBlock()
        arquivo     = getattr(self._editor, "file_path", None)
        bloco_texto = cursor.block().text()
        char_antes  = bloco_texto[coluna - 1] if coluna > 0 else ""

        if char_antes in (" ", "\t", ")", "]", "}", ",", ";", '"', "'"):
            self.fechar()
            return

        # Prefixo atual
        inicio = coluna
        while inicio > 0 and (bloco_texto[inicio-1].isalnum() or bloco_texto[inicio-1] == "_"):
            inicio -= 1
        prefixo = bloco_texto[inicio:coluna]

        try:
            # Passa o project_path pro Jedi via Project — isso faz ele achar
            # os pacotes instalados no .venv mesmo com create_environment
            kwargs = dict(code=codigo, path=arquivo, environment=self._ambiente)
            if self._proj_jedi:
                kwargs["project"] = jedi.Project(
                    path=self._proj_jedi,
                    added_sys_path=self._sys_path_do_venv(),
                )
            script = jedi.Script(**kwargs)
            completions = script.complete(linha, coluna)
            print(f"[JEDI] complete({linha},{coluna}) → {len(completions)} | char='{char_antes}' prefixo='{prefixo}'")
        except Exception as e:
            import traceback
            print(f"[JEDI] ERRO: {e}")
            traceback.print_exc()
            self.fechar()
            return

        sugestoes = []
        for c in completions[:40]:
            tipo  = c.type or "statement"
            assin = ""
            if tipo == "function":
                try:
                    sigs = c.get_signatures()
                    if sigs:
                        assin = sigs[0].to_string()
                except Exception:
                    pass
            desc = ""
            try:
                desc = c.docstring(raw=True)[:80]
            except Exception:
                pass
            sugestoes.append({"nome": c.name, "tipo": tipo, "descricao": desc, "assinatura": assin})

        if sugestoes:
            self._lista.mostrar_sugestoes(sugestoes, prefixo)
        else:
            self.fechar()

    def _sys_path_do_venv(self) -> list[str]:
        """Retorna os site-packages do .venv do projeto."""
        if not self._project_path:
            return []
        caminhos = [
            os.path.join(self._project_path, ".venv", "Lib", "site-packages"),           # Windows
            os.path.join(self._project_path, ".venv", "lib", "python3.10", "site-packages"),
            os.path.join(self._project_path, ".venv", "lib", "python3.11", "site-packages"),
            os.path.join(self._project_path, ".venv", "lib", "python3.12", "site-packages"),
            os.path.join(self._project_path, ".venv", "lib", "python3.13", "site-packages"),
        ]
        return [c for c in caminhos if os.path.isdir(c)]

    def _inserir_sugestao(self, nome: str, tamanho_prefixo: int):
        cursor = self._editor.textCursor()
        for _ in range(tamanho_prefixo):
            cursor.deletePreviousChar()
        cursor.insertText(nome)
        self._editor.setTextCursor(cursor)
        self._editor.setFocus()
