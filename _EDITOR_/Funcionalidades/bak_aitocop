"""
Autocomplete com Jedi — usa o .venv do projeto aberto.
"""
import os
import sys
from PySide6.QtWidgets import QListWidget, QListWidgetItem, QAbstractItemView
from PySide6.QtCore import Qt, Signal, QTimer
from PySide6.QtGui import QFont, QColor

try:
    import jedi
    JEDI_DISPONIVEL = True
    print(f"[AUTOCOMPLETE] ✅ Jedi {jedi.__version__} carregado")
except ImportError:
    JEDI_DISPONIVEL = False
    print("[AUTOCOMPLETE] ❌ Jedi não encontrado — pip install jedi")

_ICONE = {
    "module":    "📦", "class":     "🔷", "instance":  "🔹",
    "function":  "🔵", "param":     "📌", "keyword":   "🔑",
    "statement": "📄", "import":    "📥", "path":      "📂", "property":  "⚙",
}
_COR = {
    "module": "#98c379", "class": "#56b6c2", "instance": "#e0e0e0",
    "function": "#61afef", "param": "#e5c07b", "keyword": "#c678dd",
    "statement": "#abb2bf", "import": "#98c379",
}


def _python_do_venv(project_path: str) -> str | None:
    if not project_path:
        return None
    for c in [
        os.path.join(project_path, ".venv", "Scripts", "python.exe"),
        os.path.join(project_path, ".venv", "bin", "python"),
        os.path.join(project_path, ".venv", "bin", "python3"),
    ]:
        if os.path.exists(c):
            return c
    return None


def _criar_ambiente(project_path: str | None):
    """
    Retorna (ambiente, project_path_para_jedi).
    Prefere o .venv do projeto; cai no InterpreterEnvironment se não achar.
    """
    if not JEDI_DISPONIVEL:
        return None, None

    python_path = _python_do_venv(project_path)

    if python_path:
        try:
            env = jedi.create_environment(python_path, safe=False)
            print(f"[AUTOCOMPLETE] Usando .venv do projeto: {python_path}")
            return env, project_path
        except Exception as e:
            print(f"[AUTOCOMPLETE] create_environment falhou ({e})")

    try:
        env = jedi.InterpreterEnvironment()
        print(f"[AUTOCOMPLETE] Usando InterpreterEnvironment: {sys.executable}")
        return env, project_path
    except Exception as e:
        print(f"[AUTOCOMPLETE] InterpreterEnvironment falhou ({e})")

    return None, None


