# Lista visual
# ══════════════════════════════════════════════════════════════════════════════

class ListaAutocomplete(QListWidget):
    sugestao_confirmada = Signal(str, int)

    def __init__(self, editor):
        super().__init__(editor)
        self._editor  = editor
        self._prefixo = ""
        self.setWindowFlags(Qt.ToolTip)
        self.setFocusPolicy(Qt.NoFocus)
        self.setSelectionMode(QAbstractItemView.SingleSelection)
        self.setMaximumHeight(220)
        self.setMinimumWidth(260)
        self.setMaximumWidth(500)
        self.setFont(QFont("Consolas", 11))
        self.setStyleSheet("""
            QListWidget {
                background-color: #1a1a2e; color: #e0e0e0;
                border: 1px solid #4a90d9; border-radius: 4px;
                padding: 2px; outline: none;
            }
            QListWidget::item { padding: 3px 8px; border-radius: 2px; }
            QListWidget::item:hover    { background-color: #264f78; }
            QListWidget::item:selected { background-color: #2d5a8e; color: #ffffff; }
            QScrollBar:vertical         { width: 6px; background: transparent; }
            QScrollBar::handle:vertical { background: #3a3a3a; border-radius: 3px; }
        """)
        self.itemClicked.connect(self._ao_clicar)
        self.hide()

    def mostrar_sugestoes(self, sugestoes: list, prefixo: str):
        self._prefixo = prefixo
        self.clear()
        for s in sugestoes:
            icone = _ICONE.get(s["tipo"], "•")
            assin = f"  {s['assinatura']}" if s.get("assinatura") else ""
            item  = QListWidgetItem(f"{icone}  {s['nome']}{assin}")
            item.setData(Qt.UserRole, s["nome"])
            item.setToolTip(s.get("descricao", ""))
            item.setForeground(QColor(_COR.get(s["tipo"], "#e0e0e0")))
            self.addItem(item)
        if self.count() == 0:
            self.hide()
            return
        self.setCurrentRow(0)
        ponto = self._editor.cursorRect().bottomLeft()
        ponto = self._editor.mapToGlobal(ponto)
        self.move(ponto)
        self.adjustSize()
        self.setFixedWidth(max(260, self.sizeHintForColumn(0) + 24))
        self.show()
        self.raise_()

    def fechar(self):
        self.hide()
        self.clear()

    def navegar(self, direcao: int):
        nova = max(0, min(self.count() - 1, self.currentRow() + direcao))
        self.setCurrentRow(nova)

    def confirmar(self):
        item = self.currentItem()
        if item:
            nome = item.data(Qt.UserRole)
            self.sugestao_confirmada.emit(nome, len(self._prefixo))
            self.fechar()

    def _ao_clicar(self, item: QListWidgetItem):
        nome = item.data(Qt.UserRole)
        self.sugestao_confirmada.emit(nome, len(self._prefixo))
        self.fechar()


